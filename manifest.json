{
  "manifest_version": 3,
  "name": "Claude Code ↔ GitHub PR Link",
  "short_name": "Claude PR Link",
  "version": "0.1.0",
  "description": "Remembers which Claude Code session produced each GitHub pull request and adds a deep link to the session on the PR.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Claude Code ↔ GitHub PR Link",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://claude.ai/*", "https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/shared/core.js", "src/shared/claude-api.js", "src/content/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["src/shared/core.js", "src/content/github.js"],
      "css": ["src/content/github.css"],
      "run_at": "document_idle"
    }
  ]
}
