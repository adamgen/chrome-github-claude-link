{
  "manifest_version": 3,
  "name": "Claude Code ↔ GitHub PR Link",
  "short_name": "Claude PR Link",
  "version": "0.2.0",
  "description": "Links GitHub pull requests to the local Claude Code sessions that made them, with a deep link that opens the session in the Claude app.",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Claude Code ↔ GitHub PR Link",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/content/github.js"
      ],
      "css": [
        "src/content/github.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
